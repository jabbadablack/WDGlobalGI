 *
 * Shared helpers for the WDGlobalGI (Dagor GI) solution: clipmap addressing, the HL2 Ambient Cube
 * basis, ray-direction sampling and a tiny RNG. Only constant members of PassSrg are referenced here
 * (every GI shader declares the same constant block), so these helpers are texture-access agnostic.
 */

#pragma once

#include <WDGlobalGISharedConstants.azsli>

static const float WDGI_PI = 3.14159265359f;
static const float WDGI_TWO_PI = 6.28318530718f;

// Screen-space probe layout (must match WDGlobalGILimits in WDGlobalGIConfiguration.h). The screen
// tile size is not here: it is resolution-dependent and arrives as PassSrg::m_screenProbeTileSize.
#define WDGI_SP_OCTA 8     // octahedral radiance resolution per probe (WDGI_SP_OCTA x WDGI_SP_OCTA)
#define WDGI_SP_COEFFS 9   // order-2 irradiance SH coefficients per probe
#define WDGI_SP_MAXDIST 200.0f // probe hit distances are stored normalised by this (fp16 headroom)

// ---------------------------------------------------------------------------------------------
// RNG + ray sampling
// ---------------------------------------------------------------------------------------------

uint WDGI_Hash(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float WDGI_RandFromUint(uint x)
{
    return (WDGI_Hash(x) & 0x00ffffffu) / 16777216.0f;
}

//! Fibonacci-sphere direction i of n, jittered by a per-probe seed to decorrelate frames.
float3 WDGI_SphereDir(uint i, uint n, uint seed)
{
    float jitter = WDGI_RandFromUint(seed);
    float t = (float(i) + jitter) / float(max(n, 1u));
    float phi = WDGI_TWO_PI * frac(float(i) * 0.61803398875f + WDGI_RandFromUint(seed + 7u));
    float cosTheta = 1.0f - 2.0f * t;
    float sinTheta = sqrt(saturate(1.0f - cosTheta * cosTheta));
    return float3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
}

// ---------------------------------------------------------------------------------------------
// Equal-area octahedral mapping (unit direction <-> [0,1]^2), after Clarberg 2008 - the same
// mapping daGI2 and Lumen use. Equal-area matters: every texel then subtends the identical solid
// angle 4*PI/res^2, which is what makes the flat 4*PI/N weight in the SH projection correct and
// lets a per-texel direction jitter integrate without a per-texel weight. Interior texel j stands
// for the direction at its centre, decode(((j + 0.5) / res) * 2 - 1); WDGI_OctaTexelDir and
// WDGI_OctaNearestTexel are exact inverses so the write and read sides cannot drift apart.
// ---------------------------------------------------------------------------------------------

float2 WDGI_OctaEncode(float3 dir)
{
    float3 a = abs(dir);
    float r = sqrt(saturate(1.0f - a.z));
    float mx = max(a.x, a.y);
    float mn = min(a.x, a.y);
    float b = (mx == 0.0f) ? 0.0f : (mn / mx);

    float phi = atan(b) * (2.0f / WDGI_PI);
    phi = (a.x < a.y) ? (1.0f - phi) : phi;

    float v = phi * r;
    float u = r - v;
    if (dir.z < 0.0f)
    {
        float t = u;
        u = 1.0f - v;
        v = 1.0f - t;
    }
    u = (dir.x < 0.0f) ? -u : u;
    v = (dir.y < 0.0f) ? -v : v;
    return float2(u, v) * 0.5f + 0.5f;
}

float3 WDGI_OctaDecode(float2 uv)
{
    float2 f = uv * 2.0f - 1.0f;
    float2 af = abs(f);
    float signedDistance = 1.0f - (af.x + af.y);
    float r = 1.0f - abs(signedDistance);

    float phi = ((r == 0.0f) ? 1.0f : ((af.y - af.x) / r + 1.0f)) * (WDGI_PI * 0.25f);
    float z = sign(signedDistance) * (1.0f - r * r);
    float cosPhi = sign(f.x) * cos(phi);
    float sinPhi = sign(f.y) * sin(phi);
    float scaleXY = r * sqrt(max(2.0f - r * r, 0.0f));
    return float3(cosPhi * scaleXY, sinPhi * scaleXY, z);
}

// The probe's octahedral map covers the hemisphere around its surface normal, not the whole sphere:
// indirect light only arrives from above the surface, so a full-sphere map would spend half its
// texels below it. Squeezing the sphere map into the |u|+|v| <= 1 diamond with a 45-degree rotation
// keeps the mapping equal-area (the rotation's jacobian is constant), so the 8x8 map doubles its
// angular resolution for the same 64 rays. The square's whole boundary is the horizon, so out-of-
// domain lookups clamp to it rather than wrapping the way a sphere map would.

float3 WDGI_HemiOctaDecode(float2 uv)
{
    float2 f = uv * 2.0f - 1.0f;
    float2 d = float2(f.x + f.y, f.x - f.y) * 0.5f;
    return WDGI_OctaDecode(d * 0.5f + 0.5f);
}

float2 WDGI_HemiOctaEncode(float3 dir)
{
    float2 d = WDGI_OctaEncode(dir) * 2.0f - 1.0f;
    return float2(d.x + d.y, d.x - d.y) * 0.5f + 0.5f;
}

void WDGI_ProbeTangentFrame(float3 n, out float3 tangent, out float3 bitangent)
{
    float3 up = (abs(n.z) < 0.999f) ? float3(0.0f, 0.0f, 1.0f) : float3(1.0f, 0.0f, 0.0f);
    tangent = normalize(cross(up, n));
    bitangent = cross(n, tangent);
}

float3 WDGI_HemisphereTexelDirOffset(uint2 octa, float3 n, float2 offset)
{
    float3 local = WDGI_HemiOctaDecode((float2(octa) + 0.5f + offset) / float(WDGI_SP_OCTA));
    float3 tangent, bitangent;
    WDGI_ProbeTangentFrame(n, tangent, bitangent);
    return local.x * tangent + local.y * bitangent + local.z * n;
}

float3 WDGI_HemisphereTexelDir(uint2 octa, float3 n)
{
    return WDGI_HemisphereTexelDirOffset(octa, n, float2(0.0f, 0.0f));
}

float2 WDGI_HemisphereEncode(float3 dir, float3 n)
{
    float3 tangent, bitangent;
    WDGI_ProbeTangentFrame(n, tangent, bitangent);
    float3 local = float3(dot(dir, tangent), dot(dir, bitangent), dot(dir, n));
    return saturate(WDGI_HemiOctaEncode(normalize(local)));
}

int2 WDGI_HemisphereNearestTexel(float3 dir, float3 n)
{
    uint2 t = uint2(WDGI_HemisphereEncode(dir, n) * float(WDGI_SP_OCTA));
    return int2(min(t, uint2(WDGI_SP_OCTA - 1, WDGI_SP_OCTA - 1)));
}

struct WDGI_OctaTaps
{
    int2 m_texel[4];
    float m_weight[4];
};

WDGI_OctaTaps WDGI_HemisphereBilinearTaps(float3 dir, float3 n)
{
    float2 p = WDGI_HemisphereEncode(dir, n) * float(WDGI_SP_OCTA) - 0.5f;
    int2 b = int2(floor(p));
    float2 f = saturate(p - float2(b));

    const int hi = int(WDGI_SP_OCTA) - 1;
    WDGI_OctaTaps taps;
    taps.m_texel[0] = clamp(b + int2(0, 0), int2(0, 0), int2(hi, hi));
    taps.m_texel[1] = clamp(b + int2(1, 0), int2(0, 0), int2(hi, hi));
    taps.m_texel[2] = clamp(b + int2(0, 1), int2(0, 0), int2(hi, hi));
    taps.m_texel[3] = clamp(b + int2(1, 1), int2(0, 0), int2(hi, hi));
    taps.m_weight[0] = (1.0f - f.x) * (1.0f - f.y);
    taps.m_weight[1] = f.x * (1.0f - f.y);
    taps.m_weight[2] = (1.0f - f.x) * f.y;
    taps.m_weight[3] = f.x * f.y;
    return taps;
}

// ---------------------------------------------------------------------------------------------
// Order-2 spherical harmonics (9 coefficients). Used to compress each screen probe's octahedral
// radiance into a smooth, cheap-to-interpolate per-probe irradiance.
// ---------------------------------------------------------------------------------------------

//! Evaluate the 9 real SH basis functions for a unit direction.
void WDGI_SHBasis(float3 d, out float Y[9])
{
    Y[0] = 0.282095f;
    Y[1] = 0.488603f * d.y;
    Y[2] = 0.488603f * d.z;
    Y[3] = 0.488603f * d.x;
    Y[4] = 1.092548f * d.x * d.y;
    Y[5] = 1.092548f * d.y * d.z;
    Y[6] = 0.315392f * (3.0f * d.z * d.z - 1.0f);
    Y[7] = 1.092548f * d.x * d.z;
    Y[8] = 0.546274f * (d.x * d.x - d.y * d.y);
}

//! Cosine-lobe convolution factor per SH band (l=0,1,2) - turns a radiance SH into an irradiance SH.
float WDGI_SHCosineBand(int index)
{
    if (index == 0) return 3.14159265f;      // A0 = PI
    if (index < 4)  return 2.0943951f;        // A1 = 2*PI/3
    return 0.7853982f;                        // A2 = PI/4
}

//! Evaluate irradiance E(n) from 9 RGB irradiance-SH coefficients (already cosine-convolved).
float3 WDGI_SHEvalIrradiance(float3 coeffs[9], float3 n)
{
    float Y[9];
    WDGI_SHBasis(n, Y);
    float3 e = float3(0.0f, 0.0f, 0.0f);
    [unroll] for (int i = 0; i < 9; ++i)
    {
        e += coeffs[i] * Y[i];
    }
    return max(e, float3(0.0f, 0.0f, 0.0f));
}

// How much a probe should contribute to this pixel, following daGI2's sp_upsample_weights.hlsl.
// The dominant term is the probe's distance from the shading point's tangent plane, divided by the
// shading point's depth so the tolerance scales with distance; the weight falls below 0.01 once the
// probe is about 2.6% of the depth off the plane. The secondary, much gentler relative-depth term is
// what separates two probes sitting on *different* surfaces that happen to share a plane - a wall
// corner seen at a glancing angle. Plane distance alone blends across that corner; depth alone kills
// the bilinear on a single flat wall and brings the probe lattice back, so both are needed.
// There is deliberately no separate normal test: the normal already defines the plane, and a probe on
// a differently-oriented surface is rejected by the plane distance.
float WDGI_ProbeWeightScaled(float3 probeWorld, float3 worldPos, float3 worldNormal, float sceneDepth, float expScale)
{
    const float depthExp = -10000.0f;
    const float depthTermExp = -3.0f;

    float invDepth = 1.0f / max(sceneDepth, 1e-4f);
    float planeDist = dot(probeWorld - worldPos, worldNormal) * invDepth;
    float relDepth = planeDist * planeDist;

    float probeDepth = distance(probeWorld, PassSrg::m_cameraWorldPos.xyz);
    relDepth += (depthTermExp / depthExp) * abs(probeDepth - sceneDepth) * invDepth;

    return exp2(depthExp * expScale * relDepth);
}

float WDGI_ProbeWeight(float3 probeWorld, float3 worldPos, float3 worldNormal, float sceneDepth)
{
    return WDGI_ProbeWeightScaled(probeWorld, worldPos, worldNormal, sceneDepth, 1.0f);
}

// ---------------------------------------------------------------------------------------------
// Screen-probe placement data. Two uints per probe, following daGI2's screen_probes_encoding.hlsl:
//   .x  bits  0..23  anchor depth, the top 24 bits of the raw depth float (exact, free to pack)
//       bit      24  valid (the anchor pixel has a surface)
//       bit      25  reserved
//       bits 26..31  reversed age, 63 = brand new, 0 = fully converged
//   .y  bits  0..21  surface normal, 11:11 equal-area octahedral
//       bits 22..31  anchor offset inside the tile, 5 bits per axis
// The world position is never stored: it is reconstructed from the anchor pixel and depth, so
// every consumer agrees on where the probe is by construction.
// ---------------------------------------------------------------------------------------------

#define WDGI_PROBE_VALID_BIT  (1u << 24u)
#define WDGI_PROBE_MAX_AGE    63u

uint WDGI_PackProbeDepth(float rawDepth, bool valid, uint reverseAge)
{
    uint packed = (asuint(rawDepth) >> 8u) & 0x00ffffffu;
    packed |= valid ? WDGI_PROBE_VALID_BIT : 0u;
    packed |= (min(reverseAge, WDGI_PROBE_MAX_AGE) << 26u);
    return packed;
}

float WDGI_UnpackProbeDepth(uint packed)
{
    return asfloat((packed & 0x00ffffffu) << 8u);
}

bool WDGI_ProbeValid(uint packed)
{
    return (packed & WDGI_PROBE_VALID_BIT) != 0u;
}

uint WDGI_UnpackProbeAge(uint packed)
{
    return packed >> 26u;
}

uint WDGI_PackProbeNormalOffset(float3 normal, uint2 offset)
{
    float2 e = saturate(WDGI_OctaEncode(normal));
    uint2 q = uint2(e * 2047.0f + 0.5f);
    uint2 o = min(offset, uint2(31u, 31u));
    return q.x | (q.y << 11u) | (o.x << 22u) | (o.y << 27u);
}

float3 WDGI_UnpackProbeNormal(uint packed)
{
    float2 e = float2(float(packed & 2047u), float((packed >> 11u) & 2047u)) / 2047.0f;
    return WDGI_OctaDecode(e);
}

uint2 WDGI_UnpackProbeOffset(uint packed)
{
    return uint2((packed >> 22u) & 31u, (packed >> 27u) & 31u);
}

uint2 WDGI_ProbeAnchorPixel(uint2 probeData, uint2 tile, uint tileSize, uint2 screenRes)
{
    uint2 offset = min(WDGI_UnpackProbeOffset(probeData.y), uint2(tileSize - 1u, tileSize - 1u));
    return min(tile * tileSize + offset, screenRes - uint2(1, 1));
}

//! Reconstruct a probe's world position from its packed data. 'clipToWorld' is the inverse
//! view-projection of the frame that probe data belongs to.
bool WDGI_ProbeWorldFromData(
    uint2 probeData, uint2 tile, uint tileSize, uint2 screenRes, float4x4 clipToWorld, out float3 worldPos)
{
    worldPos = float3(0.0f, 0.0f, 0.0f);
    if (!WDGI_ProbeValid(probeData.x))
    {
        return false;
    }
    uint2 px = WDGI_ProbeAnchorPixel(probeData, tile, tileSize, screenRes);
    float2 uv = (float2(px) + 0.5f) / float2(screenRes);
    float4 clip = float4(uv.x * 2.0f - 1.0f, (1.0f - uv.y) * 2.0f - 1.0f, WDGI_UnpackProbeDepth(probeData.x), 1.0f);
    float4 h = mul(clipToWorld, clip);
    if (abs(h.w) < 1e-6f)
    {
        return false;
    }
    worldPos = h.xyz / h.w;
    return true;
}

//! Which probe tile this surface point occupied in the previous frame, if it was on screen at all.
//! With a motion vector the answer follows moving geometry as well as the camera; without one it
//! falls back to reprojecting through last frame's view-projection, which only tracks the camera.
//! The caller samples the motion vector because that texture is per-pass, not part of the shared set.
bool WDGI_PrevProbeTile(
    float3 worldPos, float2 anchorUv, float2 motionVector, bool hasMotionVector,
    uint2 screenRes, uint tileSize, uint2 tileCount, out uint2 prevTile)
{
    prevTile = uint2(0, 0);

    float2 uv;
    if (hasMotionVector)
    {
        // Motion vectors store the direction of movement, so the history sits the other way.
        uv = anchorUv - motionVector;
    }
    else
    {
        float4 clip = mul(PassSrg::m_prevWorldToClip, float4(worldPos, 1.0f));
        if (clip.w <= 1e-4f)
        {
            return false;
        }
        float2 ndc = clip.xy / clip.w;
        uv = float2(ndc.x * 0.5f + 0.5f, 0.5f - ndc.y * 0.5f);
    }

    if (uv.x < 0.0f || uv.x > 1.0f || uv.y < 0.0f || uv.y > 1.0f)
    {
        return false;
    }
    prevTile = min((uint2)(uv * float2(screenRes) / float(tileSize)), tileCount - uint2(1, 1));
    return true;
}

//! Sub-texel ray offset, confined to the texel's own cell. Confinement is what makes the temporal
//! blend an unbiased estimator of the cell's mean radiance rather than a blur across cells, and
//! equal-area octahedral is what lets that hold without a per-texel weight. The spatial hash
//! decorrelates neighbouring texels; the R2 sequence walks the samples over time.
float2 WDGI_ProbeRayJitter(uint2 tile, uint2 octa, uint sequenceIndex)
{
    uint seed = (tile.y * 4096u + tile.x) * uint(WDGI_SP_OCTA * WDGI_SP_OCTA)
              + octa.y * uint(WDGI_SP_OCTA) + octa.x;
    float2 base = float2(WDGI_RandFromUint(seed), WDGI_RandFromUint(seed + 0x9E3779B9u));
    const float2 r2 = float2(0.7548776662f, 0.5698402910f);
    return frac(base + r2 * float(sequenceIndex)) - 0.5f;
}

// ---------------------------------------------------------------------------------------------
// Clipmap addressing
// ---------------------------------------------------------------------------------------------

int3 WDGI_GridRes()
{
    return int3(PassSrg::m_gridResolution);
}

float WDGI_CascadeCellSize(int c)
{
    return PassSrg::m_cascadeCenterAndCell[c].w;
}

int3 WDGI_CascadeCenterCell(int c)
{
    return int3(round(PassSrg::m_cascadeCenterAndCell[c].xyz));
}

//! World position -> integer cell index inside cascade c.
int3 WDGI_WorldCell(float3 worldPos, int c)
{
    return int3(floor(worldPos / WDGI_CascadeCellSize(c)));
}

//! Select the finest cascade whose window contains worldPos. Returns -1 if outside all cascades.
int WDGI_SelectCascade(float3 worldPos)
{
    int3 halfRes = WDGI_GridRes() / 2;
    for (uint c = 0; c < PassSrg::m_cascadeCount; ++c)
    {
        int3 cell = WDGI_WorldCell(worldPos, (int)c);
        int3 d = abs(cell - WDGI_CascadeCenterCell((int)c));
        if (d.x < halfRes.x && d.y < halfRes.y && d.z < halfRes.z)
        {
            return (int)c;
        }
    }
    return -1;
}

//! Toroidal physical texel for a world cell (grid resolution is power-of-two).
int3 WDGI_PhysicalCell(int3 worldCell)
{
    int3 mask = WDGI_GridRes() - 1;
    return worldCell & mask;
}

//! Recover the unique "live" world cell that a physical texel maps to within cascade c.
int3 WDGI_LiveWorldCell(int3 physical, int c)
{
    int3 mask = WDGI_GridRes() - 1;
    int3 originCell = WDGI_CascadeCenterCell(c) - WDGI_GridRes() / 2;
    return originCell + ((physical - originCell) & mask);
}

//! Texel into the radiance clipmap (cascades stacked along Z).
int3 WDGI_RadianceTexel(int3 physical, int c)
{
    return int3(physical.x, physical.y, c * WDGI_GridRes().z + physical.z);
}

//! Texel into the irradiance clipmap (cascade*face slabs stacked along Z).
int3 WDGI_IrradianceTexel(int3 physical, int c, int face)
{
    return int3(physical.x, physical.y, (c * WDGLOBALGI_FACE_COUNT + face) * WDGI_GridRes().z + physical.z);
}

// ---------------------------------------------------------------------------------------------
// HL2 Ambient Cube
// ---------------------------------------------------------------------------------------------

//! Face directions, order: +X, -X, +Y, -Y, +Z, -Z. Uses conditionals (rather than a dynamically
//! indexed local array) so it compiles cleanly even when called with a non-constant face index.
float3 WDGI_AmbientCubeDir(int face)
{
    if (face == 0) return float3( 1.0f,  0.0f,  0.0f);
    if (face == 1) return float3(-1.0f,  0.0f,  0.0f);
    if (face == 2) return float3( 0.0f,  1.0f,  0.0f);
    if (face == 3) return float3( 0.0f, -1.0f,  0.0f);
    if (face == 4) return float3( 0.0f,  0.0f,  1.0f);
    return float3( 0.0f,  0.0f, -1.0f);
}

//! Evaluate the ambient cube for a normal, sampling 3 of the 6 faces based on the normal's sign.
float3 WDGI_EvalAmbientCube(float3 faceColors[WDGLOBALGI_FACE_COUNT], float3 n)
{
    float3 nSq = n * n;
    float3 cX = (n.x >= 0.0f) ? faceColors[0] : faceColors[1];
    float3 cY = (n.y >= 0.0f) ? faceColors[2] : faceColors[3];
    float3 cZ = (n.z >= 0.0f) ? faceColors[4] : faceColors[5];
    return nSq.x * cX + nSq.y * cY + nSq.z * cZ;
}

//! Cheap analytic sky used when a ray escapes the voxel cascades.
float3 WDGI_Sky(float3 dir)
{
    float up = saturate(dir.z * 0.5f + 0.5f);
    float3 sky = PassSrg::m_skyColorIntensity.rgb * PassSrg::m_skyColorIntensity.a;
    return sky * lerp(0.35f, 1.0f, up);
}

//! Reconstruct world-space position from a non-linear depth sample using the clip->world matrix
//! constant (self-contained: avoids a ViewSrg binding that the raw compute passes do not provide).
float3 WDGI_ReconstructWorldPos(float2 uv, float depth)
{
    float x = uv.x * 2.0f - 1.0f;
    float y = (1.0f - uv.y) * 2.0f - 1.0f;
    float4 clipPos = float4(x, y, depth, 1.0f);
    float4 worldPos = mul(PassSrg::m_clipToWorld, clipPos);
    return worldPos.xyz / worldPos.w;
}
