 *
 * WDGlobalGI cross-probe radiance filter. Each probe traces only 64 rays, so its octahedral radiance
 * is noisy; neighbouring probes on the same surface have traced the same scene from a slightly
 * different point, and sharing between them is far cheaper than tracing more rays.
 *
 * The filter runs on radiance, before the spherical-harmonic convolution rather than after it: an SH
 * blur can only smooth an already-projected 9-coefficient signal, while filtering the radiance itself
 * feeds the convolution more samples per direction. Neighbours are weighted by the same plane test the
 * upsample uses, at half its strictness, and by how little the neighbour's hit point shifts direction
 * when viewed from this probe - which is what keeps a near-field occluder in one probe from bleeding
 * into its neighbours while still sharing distant and sky radiance freely.
 */

#include <Atom/Features/SrgSemantics.azsli>
#include <WDGlobalGISharedConstants.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2D<uint2>    m_screenProbeData;             // per-probe anchor + normal
    Texture2D<float4>   m_screenProbeAtlas;            // temporally accumulated radiance, a = hit distance
    RWTexture2D<float4> m_screenProbeRadianceFiltered; // cross-probe filtered radiance

    WDGLOBALGI_SHARED_CONSTANTS

    uint4 m_screenProbeInfo;
    uint  m_screenProbeTileSize;
    float m_screenProbeBlur;   // 0 = passthrough, 1 = full filter
}

#include <WDGlobalGICommon.azsli>

// Near cross first: those four are always taken. A probe that is still converging also takes the
// diagonals and a wider cross, trading a little detail for a faster settle while its own samples are
// few - the same widen-while-young rule daGI2 applies.
static const int2 s_filterOffsets[12] =
{
    int2( 0, -1), int2( 0,  1), int2(-1,  0), int2( 1,  0),
    int2(-1, -1), int2( 1, -1), int2(-1,  1), int2( 1,  1),
    int2( 0, -2), int2( 0,  2), int2(-2,  0), int2( 2,  0)
};

[numthreads(8, 8, 1)]
void MainCS(uint3 dispatch_id : SV_DispatchThreadID)
{
    uint2 atlasCoord = dispatch_id.xy;
    uint tilesX = PassSrg::m_screenProbeInfo.z;
    uint tilesY = PassSrg::m_screenProbeInfo.w;
    if (atlasCoord.x >= tilesX * WDGI_SP_OCTA || atlasCoord.y >= tilesY * WDGI_SP_OCTA)
    {
        return;
    }

    int2 tile = int2(atlasCoord / WDGI_SP_OCTA);
    uint2 octa = atlasCoord % WDGI_SP_OCTA;
    uint2 screenRes = PassSrg::m_screenProbeInfo.xy;
    uint tileSize = PassSrg::m_screenProbeTileSize;

    float4 centre = PassSrg::m_screenProbeAtlas.Load(int3(atlasCoord, 0));
    uint2 centreData = PassSrg::m_screenProbeData.Load(int3(tile, 0)).xy;

    float3 centreWorld;
    float strength = saturate(PassSrg::m_screenProbeBlur);
    if (strength <= 0.001f ||
        !WDGI_ProbeWorldFromData(centreData, uint2(tile), tileSize, screenRes, PassSrg::m_clipToWorld, centreWorld))
    {
        PassSrg::m_screenProbeRadianceFiltered[atlasCoord] = centre;
        return;
    }

    float3 centreNormal = WDGI_UnpackProbeNormal(centreData.y);
    float3 dir = WDGI_HemisphereTexelDir(octa, centreNormal);
    float centreDepth = distance(centreWorld, PassSrg::m_cameraWorldPos.xyz);

    uint revAge = WDGI_UnpackProbeAge(centreData.x);
    int tapCount = (revAge > (WDGI_PROBE_MAX_AGE / 2u)) ? 12 : 4;

    float3 accum = centre.rgb;
    float weightSum = 1.0f;

    [loop] for (int i = 0; i < tapCount; ++i)
    {
        int2 nTile = tile + s_filterOffsets[i];
        if (nTile.x < 0 || nTile.y < 0 || nTile.x >= (int)tilesX || nTile.y >= (int)tilesY)
        {
            continue;
        }

        uint2 nData = PassSrg::m_screenProbeData.Load(int3(nTile, 0)).xy;
        float3 nWorld;
        if (!WDGI_ProbeWorldFromData(nData, uint2(nTile), tileSize, screenRes, PassSrg::m_clipToWorld, nWorld))
        {
            continue;
        }

        // Each probe's octahedral map is oriented to its own normal, so a neighbour's texels mean
        // different world directions than ours. Look its sample up by direction, and require the two
        // normals to broadly agree - far apart and our direction would fall below its horizon, where
        // the map has nothing to say.
        float3 nNormal = WDGI_UnpackProbeNormal(nData.y);
        float alignment = saturate(dot(centreNormal, nNormal));
        if (alignment <= 0.0f)
        {
            continue;
        }

        float w = WDGI_ProbeWeightScaled(nWorld, centreWorld, centreNormal, centreDepth, 0.5f) * alignment;
        if (w <= 1e-4f)
        {
            continue;
        }

        int2 nTexel = WDGI_HemisphereNearestTexel(dir, nNormal);
        float4 neighbour = PassSrg::m_screenProbeAtlas.Load(int3(nTile * int(WDGI_SP_OCTA) + nTexel, 0));

        // Where the neighbour's ray actually landed, seen from here. A distant or sky hit barely
        // moves and keeps its full weight; a close one swings wide and is dropped, which is exactly
        // the near-field occluder that must not be shared.
        float3 nDir = WDGI_HemisphereTexelDir(uint2(nTexel), nNormal);
        float3 hitPos = nWorld + nDir * (neighbour.a * WDGI_SP_MAXDIST);
        float3 toHit = hitPos - centreWorld;
        float toHitLen = length(toHit);
        if (toHitLen > 1e-4f)
        {
            float angle = acos(clamp(dot(toHit / toHitLen, dir), -1.0f, 1.0f));
            w *= 1.0f - saturate(angle / WDGI_PI);
        }

        accum += neighbour.rgb * w;
        weightSum += w;
    }

    float3 filtered = accum / max(weightSum, 1e-5f);
    PassSrg::m_screenProbeRadianceFiltered[atlasCoord] = float4(lerp(centre.rgb, filtered, strength), centre.a);
}
